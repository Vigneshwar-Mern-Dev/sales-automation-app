# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.next-dev-err.log
*.next-dev-out.log
.next-dev-err.log
.next-dev-out.log

# env files — only .env.example should be committed
.env
.env.*
!.env.example

# secrets and keys
*.pem
server.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/app/generated/prisma
/generated/prisma
/generated/prisma-client
/generated/prisma-live

# whatsapp auth sessions and cache
.whatsapp-auth/
.whatsapp-auth-new/
.wwebjs_cache/

# logs
/logs/

# archives
*.tar.gz
